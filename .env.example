# Copy to `.env` and fill in real values. This file is safe to commit.

# -----------------------------------------------------------------------------
# Database (required)
# The backend builds the connection URL from these vars only; DATABASE_URL is not read.
# With docker-compose.dev.yml, use host name `postgres`.
# -----------------------------------------------------------------------------
POSTGRES_USER=health_tracker
POSTGRES_PASSWORD=change_me
POSTGRES_DB=health_tracker
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# -----------------------------------------------------------------------------
# Compose published ports (optional; defaults 8000 / 3000)
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Encryption (required to store OpenAI keys and Garmin tokens in the DB)
# Server-side Fernet key, generated once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Renaming note: this was previously SETTINGS_ENCRYPTION_KEY. Rotating the VALUE
# makes every stored key/token permanently undecryptable — keep the value stable.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Auth
# JWT_SECRET_KEY: strong secret for signing tokens in production.
# COOKIE_SECURE: set to true when serving over HTTPS in production.
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# OpenAI (optional; notebook/script fallbacks — the app stores per-user keys
# encrypted in the DB via the Settings UI)
# OPENAI_FOOD_MODEL is a legacy alias that sets both models when the
# text/image-specific vars are unset.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_FOOD_TEXT_MODEL=gpt-5-nano
# OPENAI_FOOD_IMAGE_MODEL=gpt-5-mini
# OPENAI_FOOD_MODEL=

# -----------------------------------------------------------------------------
# Google Cloud Storage for meal/check-in photos (recommended for production)
# Local folder for uploaded photos when GCS is not configured (default: data/meal-photos)
# GCP_SERVICE_ACCOUNT_CREDENTIALS: base64-encoded service account JSON with
# Storage Object Admin on the bucket
# -----------------------------------------------------------------------------
# MEAL_PHOTOS_DIR=data/meal-photos
GCP_SERVICE_ACCOUNT_CREDENTIALS=
GCS_IMAGES_BUCKET_NAME=
GCS_MEAL_PHOTOS_FOLDER=meal-photos
GCS_CHECK_IN_PHOTOS_FOLDER=check-in-photos

# -----------------------------------------------------------------------------
# Garmin (optional)
# GARMIN_FETCH_CONCURRENCY: max parallel day fetches for week/month gap-fill (default 3)
# GARMIN_EMAIL / GARMIN_PASSWORD: only used by the scripts/ Garmin tools
# (garmin_demo.py, backfill_garmin_health.py) — not read by the app.
# -----------------------------------------------------------------------------
# GARMIN_FETCH_CONCURRENCY=3
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Hevy (optional)
# HEVY_API_KEY: personal API key from https://hevy.com/settings?developer —
# enables the /api/external/hevy/* endpoints (workout sync + write proxies).
# HEVY_WEBHOOK_TOKEN: shared secret Hevy sends in the webhook Authorization
# header; the /api/hevy/webhook receiver rejects requests without it.
# -----------------------------------------------------------------------------
HEVY_API_KEY=
HEVY_WEBHOOK_TOKEN=
